# NVIDIA Build (build.nvidia.com) API key — used by /api/chat for the RAG assistant.
# Get yours at https://build.nvidia.com -> any model -> "Get API Key"
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the default model. Defaults to moonshotai/kimi-k2-instruct.
# NVIDIA_MODEL=moonshotai/kimi-k2-instruct
